{
  "name": "glitchgen",
  "version": "0.4.1",
  "description": "Web application for building retro-inspired websites using modern web technologies. Building a time machine to the 90s web.",
  "main": "public/index.html",
  "scripts": {
    "build": "webpack --mode=production",
    "build:css": "tailwindcss -i ./src/css/styles.css -o ./public/css/styles.css --minify",
    "dev": "npx serve public -l 3000",
    "start": "npx serve public -l 3000"
  },
  "keywords": [
    "AI",
    "webapp",
    "builder"
  ],
  "author": "Pau Garcia-Mila",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.9",
    "webpack": "^5.105.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "emoji-mart": "^5.6.0",
    "gsap": "^3.14.2"
  }
}
